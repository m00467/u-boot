bootdelay=2
stdin=button-kbd
stdout=vidconsole
platform=mt6771
loaddaddr=47000000
fastboot_addr_r=47000000

fastboot=fastboot usb 0 -l $fastboot_addr_r
fastboot_bootcmd=bootm $fastboot_addr_r
#sd_bootcmd=mmc dev 1 && fatload mmc 1:1 ${loadaddr} boot.img && bootm ${loadaddr}
emmc_bootcmd=read mmc 0#boot_a ${loadaddr} 0 0x10000 && bootm ${loadaddr}
menucmd=setenv bootmenu_delay -1; bootmenu

bootmenu_0=eMMC boot=run emmc_bootcmd; pause; run menucmd
bootmenu_1=Enter fastboot mode=run fastboot; pause; run menucmd
bootmenu_2=Enable USB serial=setenv stdin button-kbd,usbacm; setenv stdout vidconsole,usbacm; setenv stderr usbacm
bootmenu_3=Reboot=reset
bootmenu_4=Shutdown=poweroff
